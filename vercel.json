{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/grow-nomads", "destination": "/grow-login", "permanent": true },
    { "source": "/grow-nomads.html", "destination": "/grow-login", "permanent": true },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "^performance-act\\.com$" }],
      "destination": "https://www.performance-act.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
